# Copy this to ~/.config/keys.env and fill in real keys.
# Only needed for the optional Gemini engine -- the default `haiku` engine
# needs no API key at all, just an existing `claude` CLI login.
#
# Get a free key at https://aistudio.google.com/app/apikey

GEMINI_API_KEY=AIzaSy...yourkey...

# Optional extra keys (e.g. from a second Google account) -- key_rotation.py
# round-robins across however many of these are set, to work around Gemini's
# 20-calls/day/key free-tier cap.
# GEMINI_API_KEY_2=AIzaSy...secondkey...
# GEMINI_API_KEY_3=AIzaSy...thirdkey...
